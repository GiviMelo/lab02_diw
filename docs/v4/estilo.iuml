skinparam ClassBackgroundColor #FFFFFF
skinparam ClassHeaderBackgroundColor #EAF7F3
skinparam PackageBorderColor #0E1726
skinparam PackageBackgroundColor #F7F9FB
skinparam ComponentBorderColor #0A6B5E
skinparam ComponentBackgroundColor #EAF7F3
skinparam InterfaceBorderColor #0A6B5E
skinparam InterfaceBackgroundColor #FFFFFF
skinparam NodeBorderColor #0E1726
skinparam NodeBackgroundColor #F7F9FB
skinparam DatabaseBorderColor #0E1726
skinparam StateBorderColor #0A6B5E
skinparam StateBackgroundColor #EAF7F3
skinparam NoteBorderColor #C9A227
skinparam NoteBackgroundColor #FFF8E1
skinparam SequenceLifeLineBorderColor #98A2B3
